
import java.util.Scanner;

class Auction {
    String productName;
    double startingPrice;
    String winningBidder = "None";
    double highestBid;

    Auction(String productName, double startingPrice) {
        this.productName = productName.toUpperCase();
        this.startingPrice = startingPrice;
        this.highestBid = startingPrice;
    }

    void placeBid(String bidderName) {
        System.out.println("Bidder Name : " + bidderName.toUpperCase());
        System.out.println("Bid Status  : Bid Rejected - Amount Required");
    }

    void placeBid(String bidderName, double amount) {
        bidderName = bidderName.toUpperCase();

        System.out.println("Bidder Name : " + bidderName);
        System.out.printf("Bid Amount  : Rs. %.2f%n", amount);

        if (amount > highestBid) {
            highestBid = amount;
            winningBidder = bidderName;
            System.out.println("Bid Status  : Bid Accepted");
        } else {
            System.out.println(
                "Bid Status  : Bid Rejected - Bid Must Be Higher"
            );
        }
    }

    void displaySummary() {
        System.out.println("\n----- AUCTION SUMMARY -----");
        System.out.println("Product Name   : " + productName);
        System.out.println("Winning Bidder : " + winningBidder);
        System.out.printf("Final Bid Amount: Rs. %.2f%n", highestBid);
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        System.out.print("Enter product name: ");
        String name = sc.nextLine();

        System.out.print("Enter starting price: ");
        double price = sc.nextDouble();

        Auction a = new Auction(name, price);

        sc.nextLine(); 

        for (int i = 1; i <= 3; i++) {
            System.out.print("\nEnter bidder name: ");
            String bidder = sc.nextLine();

            System.out.print("Enter bid amount: ");
            double amount = sc.nextDouble();
            sc.nextLine();

            a.placeBid(bidder, amount);
        }

        a.displaySummary();
        sc.close();
    }
}
